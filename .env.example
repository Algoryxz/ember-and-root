# Required environment variables for Ember & Root
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local or any file containing actual secret values.

# ── Supabase (Public — safe to expose to browser) ──────────────────────────
# Found in: Supabase Dashboard → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Found in: Supabase Dashboard → Project Settings → API → Project API Keys → anon/public
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (Server only — NEVER expose to browser) ───────────────────────
# Found in: Supabase Dashboard → Project Settings → API → Project API Keys → service_role
# Used ONLY in seed scripts and CI migration scripts. Never in Next.js runtime.
SUPABASE_SERVICE_ROLE_KEY=
